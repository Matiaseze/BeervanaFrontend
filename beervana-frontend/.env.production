# Default para `npm run build`, que es lo que corre Vercel al deployar.
#
# Apunta al backend de PRUEBAS, no al original:
#
#   beervana-backend.vercel.app  -> el backend nuevo, con pedidos, roles,
#                                   mostrador y Mercado Pago (este)
#   beervana.vercel.app          -> el backend original, esquema viejo
#
# Para cambiarlo sin tocar el repo, se define REACT_APP_API_URL en Settings >
# Environment Variables del proyecto en Vercel: una variable real tiene
# prioridad sobre este archivo.
#
# Create React App incrusta el valor al compilar, no lo lee al ejecutar: si lo
# cambiás, hay que volver a deployar.

REACT_APP_API_URL=https://beervana-backend.vercel.app/my_api
